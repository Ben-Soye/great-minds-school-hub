FROM node:20-alpine\n\nWORKDIR /app\n\n# Copy package files\nCOPY package*.json ./\nCOPY prisma ./prisma/\n\n# Install dependencies\nRUN npm ci\n\n# Copy source code\nCOPY src ./src\nCOPY tsconfig.json ./\n\n# Generate Prisma client\nRUN npm run prisma:generate\n\n# Build application\nRUN npm run build\n\n# Expose port\nEXPOSE 5000\n\n# Start application\nCMD [\"npm\", \"start\"]\n