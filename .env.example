# Application
NODE_ENV=development
APP_NAME="Great Minds School Hub"
APP_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=gmsh_user
DB_PASSWORD=gmsh_password
DB_NAME=gmsh_dev
DATABASE_URL=postgresql://gmsh_user:gmsh_password@localhost:5432/gmsh_dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# API
API_PORT=5000
API_URL=http://localhost:5000
API_TIMEOUT=30000

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

# Frontend
VITE_API_URL=http://localhost:5000/api/v1
VITE_APP_NAME="Great Minds School Hub"

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@greatmindsschoolhub.com

# AWS S3 (File Storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=gmsh-uploads
AWS_S3_URL=https://gmsh-uploads.s3.amazonaws.com

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Monitoring (Optional)
DATADOG_API_KEY=your-datadog-key
NEW_RELIC_LICENSE_KEY=your-new-relic-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session
SESSION_SECRET=your-session-secret
SESSION_TIMEOUT=1800000

# CORS
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Feature Flags
FEATURE_OFFLINE_MODE=false
FEATURE_PWA=false
FEATURE_AI_ANALYTICS=false
